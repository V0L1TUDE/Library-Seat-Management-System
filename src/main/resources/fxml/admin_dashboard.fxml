<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.library.seatmgmt.controller.AdminDashboardController"
            fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;">

    <VBox spacing="18" style="-fx-padding: 6;">

        <!-- Admin Action Bar -->
        <HBox spacing="14" alignment="CENTER_LEFT" styleClass="card" style="-fx-padding: 14 20;">
            <VBox>
                <Label text="Floor &amp; Seat Operations" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
                <Label text="Monitor floor occupancy, add new floors (20 seats each), and manage seat maintenance" styleClass="text-muted"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="⚡ Trigger No-Show Auto Release" onAction="#handleTriggerNoShowScan" styleClass="btn-primary"/>
            <Button text="🔄 Refresh All Metrics" onAction="#loadAdminData" styleClass="btn-secondary"/>
        </HBox>

        <!-- KPI Metrics + Overall Occupancy PieChart -->
        <HBox spacing="16">
            <VBox prefWidth="440" spacing="12">
                <HBox spacing="12">
                    <VBox HBox.hgrow="ALWAYS" styleClass="stat-card">
                        <Label text="TOTAL FLOORS" styleClass="stat-label"/>
                        <Label fx:id="lblAdminTotalFloors" text="--" styleClass="stat-value" style="-fx-text-fill: -color-primary-text;"/>
                    </VBox>
                    <VBox HBox.hgrow="ALWAYS" styleClass="stat-card">
                        <Label text="TOTAL SEATS" styleClass="stat-label"/>
                        <Label fx:id="lblAdminTotalSeats" text="--" styleClass="stat-value"/>
                    </VBox>
                    <VBox HBox.hgrow="ALWAYS" styleClass="stat-card">
                        <Label text="STUDENTS" styleClass="stat-label"/>
                        <Label fx:id="lblAdminTotalStudents" text="--" styleClass="stat-value"/>
                    </VBox>
                </HBox>

                <HBox spacing="12">
                    <VBox HBox.hgrow="ALWAYS" styleClass="stat-card">
                        <Label text="AVAILABLE" styleClass="stat-label"/>
                        <Label fx:id="lblAdminAvailable" text="--" styleClass="stat-value" style="-fx-text-fill: -color-available-border;"/>
                    </VBox>
                    <VBox HBox.hgrow="ALWAYS" styleClass="stat-card">
                        <Label text="RESERVED" styleClass="stat-label"/>
                        <Label fx:id="lblAdminReserved" text="--" styleClass="stat-value" style="-fx-text-fill: -color-reserved-border;"/>
                    </VBox>
                    <VBox HBox.hgrow="ALWAYS" styleClass="stat-card">
                        <Label text="OCCUPIED" styleClass="stat-label"/>
                        <Label fx:id="lblAdminOccupied" text="--" styleClass="stat-value" style="-fx-text-fill: -color-occupied-border;"/>
                    </VBox>
                    <VBox HBox.hgrow="ALWAYS" styleClass="stat-card">
                        <Label text="MAINTENANCE" styleClass="stat-label"/>
                        <Label fx:id="lblAdminMaintenance" text="--" styleClass="stat-value" style="-fx-text-fill: -color-maintenance-text;"/>
                    </VBox>
                </HBox>
            </VBox>

            <VBox HBox.hgrow="ALWAYS" styleClass="card" alignment="CENTER">
                <Label text="Overall Library Capacity Distribution" styleClass="text-heading" style="-fx-padding: 0 0 6 0;"/>
                <PieChart fx:id="chartOccupancy" prefHeight="210" legendVisible="true"/>
            </VBox>
        </HBox>

        <!-- Admin Functional Tabs -->
        <TabPane tabClosingPolicy="UNAVAILABLE" styleClass="admin-tabs">

            <!-- Tab 1: Floor-Wise Occupancy & Add New Floor -->
            <Tab text="🏢 Floors &amp; Occupancy">
                <VBox spacing="16" style="-fx-padding: 14 0 0 0;">
                    <!-- Add New Floor Card (Automatically creates 20 seats) -->
                    <VBox spacing="12" styleClass="card">
                        <Label text="Add New Library Floor (Auto-Generates 20 Seats)" styleClass="text-heading"/>
                        <HBox spacing="12" alignment="BOTTOM_LEFT">
                            <VBox spacing="4" prefWidth="240">
                                <Label text="Floor Name" style="-fx-font-weight: bold; -fx-font-size: 11px;"/>
                                <TextField fx:id="txtNewFloorName" promptText="e.g. Fourth Floor — Section 5" styleClass="text-field"/>
                            </VBox>
                            <VBox spacing="4" prefWidth="110">
                                <Label text="Floor #" style="-fx-font-weight: bold; -fx-font-size: 11px;"/>
                                <TextField fx:id="txtNewFloorNumber" promptText="e.g. 4" styleClass="text-field"/>
                            </VBox>
                            <VBox spacing="4" HBox.hgrow="ALWAYS">
                                <Label text="Section Description" style="-fx-font-weight: bold; -fx-font-size: 11px;"/>
                                <TextField fx:id="txtNewFloorDesc" promptText="e.g. Quiet Graduate Research &amp; Thesis Carrels" styleClass="text-field"/>
                            </VBox>
                            <Button text="➕ Add Floor (+20 Seats)" onAction="#handleAddFloor" styleClass="btn-primary" style="-fx-padding: 9 18;"/>
                        </HBox>
                    </VBox>

                    <!-- Floor-Wise Occupancy Summary Table -->
                    <VBox spacing="10" styleClass="card">
                        <Label text="Floor-Wise Occupancy Breakdown (Current Slot)" styleClass="text-heading"/>
                        <TableView fx:id="tblFloorSummary" prefHeight="220" styleClass="table-view">
                            <columns>
                                <TableColumn fx:id="colFloorNum" text="Floor #" prefWidth="80"/>
                                <TableColumn fx:id="colFloorName" text="Floor Section Name" prefWidth="260"/>
                                <TableColumn fx:id="colFloorTotal" text="Total Seats" prefWidth="95"/>
                                <TableColumn fx:id="colFloorAvail" text="Available" prefWidth="95"/>
                                <TableColumn fx:id="colFloorRes" text="Reserved" prefWidth="95"/>
                                <TableColumn fx:id="colFloorOcc" text="Occupied" prefWidth="95"/>
                                <TableColumn fx:id="colFloorMaint" text="Maintenance" prefWidth="105"/>
                            </columns>
                        </TableView>
                    </VBox>
                </VBox>
            </Tab>

            <!-- Tab 2: Manage Floor Seats & Maintenance Status -->
            <Tab text="🪑 Seat Status Management">
                <VBox spacing="14" style="-fx-padding: 14 0 0 0;">
                    <HBox spacing="12" alignment="CENTER_LEFT" styleClass="card" style="-fx-padding: 12 18;">
                        <Label text="Filter by Floor:" style="-fx-font-weight: bold; -fx-font-size: 12px;"/>
                        <ComboBox fx:id="cmbAdminFloor" prefWidth="260" styleClass="combo-box"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button fx:id="btnSetAvailable" text="✅ Set Available" onAction="#handleSetSeatAvailable" styleClass="btn-success" disable="true"/>
                        <Button fx:id="btnSetMaintenance" text="🛠️ Set Maintenance" onAction="#handleSetSeatMaintenance" styleClass="btn-danger" disable="true"/>
                    </HBox>

                    <VBox spacing="10" styleClass="card">
                        <Label text="Floor Seats Inventory (Select a seat to manage status)" styleClass="text-heading"/>
                        <TableView fx:id="tblAdminSeats" prefHeight="290" styleClass="table-view">
                            <columns>
                                <TableColumn fx:id="colSeatId" text="ID" prefWidth="60"/>
                                <TableColumn fx:id="colSeatNumber" text="Seat Number" prefWidth="110"/>
                                <TableColumn fx:id="colSeatFloor" text="Library Floor" prefWidth="230"/>
                                <TableColumn fx:id="colSeatStatus" text="Operational Status" prefWidth="150"/>
                                <TableColumn fx:id="colSeatFacilities" text="Facilities" prefWidth="280"/>
                            </columns>
                            <placeholder>
                                <Label text="No seats found." styleClass="text-muted"/>
                            </placeholder>
                        </TableView>
                    </VBox>
                </VBox>
            </Tab>

            <!-- Tab 3: Student Bookings Monitor -->
            <Tab text="📋 Student Bookings">
                <VBox spacing="12" style="-fx-padding: 14 0 0 0;">
                    <VBox spacing="10" styleClass="card">
                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <Label text="Recent Student Bookings Across Floors" styleClass="text-heading"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <ComboBox fx:id="cmbAdminBookingFloor" prefWidth="240" styleClass="combo-box"/>
                        </HBox>
                        <TableView fx:id="tblAdminBookings" prefHeight="320" styleClass="table-view">
                            <columns>
                                <TableColumn fx:id="colBkId" text="ID" prefWidth="60"/>
                                <TableColumn fx:id="colBkStudent" text="Student Name" prefWidth="160"/>
                                <TableColumn fx:id="colBkRoll" text="Roll ID" prefWidth="115"/>
                                <TableColumn fx:id="colBkFloor" text="Floor" prefWidth="190"/>
                                <TableColumn fx:id="colBkSeat" text="Seat" prefWidth="75"/>
                                <TableColumn fx:id="colBkDate" text="Date" prefWidth="100"/>
                                <TableColumn fx:id="colBkTime" text="Time Slot" prefWidth="150"/>
                                <TableColumn fx:id="colBkStatus" text="Status" prefWidth="110"/>
                            </columns>
                            <placeholder>
                                <Label text="No student bookings recorded." styleClass="text-muted"/>
                            </placeholder>
                        </TableView>
                    </VBox>
                </VBox>
            </Tab>

        </TabPane>

    </VBox>
</ScrollPane>
