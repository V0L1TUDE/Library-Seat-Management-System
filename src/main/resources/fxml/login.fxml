<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.library.seatmgmt.controller.LoginController"
           prefWidth="960" prefHeight="620" styleClass="root">

    <HBox alignment="CENTER" maxWidth="840" maxHeight="520" styleClass="card"
          style="-fx-padding: 0; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.10), 24, 0, 0, 4);">

        <!-- Left Branding Panel (Deep Crimson) -->
        <VBox prefWidth="380" spacing="20" style="-fx-background-color: #450A0A; -fx-padding: 40; -fx-background-radius: 8 0 0 8;">
            <Label text="🏛️" style="-fx-font-size: 38px;"/>
            <VBox spacing="6">
                <Label text="Smart Library" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #FFFFFF;"/>
                <Label text="Floor-Wise Seat Management System" style="-fx-font-size: 14px; -fx-text-fill: #FCA5A5;"/>
            </VBox>

            <Label text="Browse independent library floors, check real-time 20-seat section availability, and reserve your study desk across campus."
                   wrapText="true" style="-fx-text-fill: #FECACA; -fx-font-size: 13px; -fx-line-spacing: 4;"/>

            <Region VBox.vgrow="ALWAYS"/>

            <VBox spacing="8" style="-fx-background-color: rgba(255,255,255,0.08); -fx-padding: 14; -fx-background-radius: 6; -fx-border-color: rgba(254,202,202,0.2); -fx-border-radius: 6;">
                <Label text="⚡ Fast Evaluation Access" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #FECACA;"/>
                <HBox spacing="10">
                    <Button text="Student Login" onAction="#fillStudentCredentials" styleClass="btn-secondary" style="-fx-font-size: 11px; -fx-padding: 5 12;"/>
                    <Button text="Admin Login" onAction="#fillAdminCredentials" styleClass="btn-secondary" style="-fx-font-size: 11px; -fx-padding: 5 12;"/>
                </HBox>
            </VBox>
        </VBox>

        <!-- Right Form Panel -->
        <VBox prefWidth="460" spacing="20" style="-fx-padding: 40 46;" alignment="CENTER_LEFT">
            <VBox spacing="4">
                <Label text="Sign In" styleClass="text-display"/>
                <Label text="Enter your institutional credentials to continue" styleClass="text-muted"/>
            </VBox>

            <Label fx:id="lblError" text="" wrapText="true" visible="false"
                   style="-fx-text-fill: #991B1B; -fx-background-color: #FEE2E2; -fx-border-color: #FCA5A5; -fx-border-radius: 4; -fx-padding: 8 12; -fx-background-radius: 4; -fx-font-size: 12px;"/>

            <VBox spacing="6">
                <Label text="Username or Roll Number" style="-fx-font-weight: bold; -fx-font-size: 12px;"/>
                <TextField fx:id="txtUsername" promptText="e.g. student1 or admin" styleClass="text-field"/>
            </VBox>

            <VBox spacing="6">
                <Label text="Password" style="-fx-font-weight: bold; -fx-font-size: 12px;"/>
                <PasswordField fx:id="txtPassword" promptText="Enter password" styleClass="password-field"/>
            </VBox>

            <Button fx:id="btnLogin" text="Sign In to Dashboard" onAction="#handleLogin"
                    maxWidth="Infinity" styleClass="btn-primary" style="-fx-font-size: 14px; -fx-padding: 12;"/>

            <HBox alignment="CENTER" spacing="8">
                <Label text="Default evaluation password:" styleClass="text-muted"/>
                <Label text="password123" style="-fx-font-weight: bold; -fx-text-fill: -color-primary-text;"/>
            </HBox>
        </VBox>
    </HBox>

</StackPane>
