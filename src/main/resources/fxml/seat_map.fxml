<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<HBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.library.seatmgmt.controller.SeatMapController"
      spacing="20" style="-fx-padding: 6;">

    <!-- Left Main Content: Floor Selector + Filters + 4x5 Visual Grid -->
    <VBox HBox.hgrow="ALWAYS" spacing="16">

        <!-- Filter Bar Card -->
        <VBox spacing="12" styleClass="card">
            <HBox spacing="16" alignment="CENTER_LEFT">
                <VBox spacing="4" prefWidth="250">
                    <Label text="Select Library Floor" style="-fx-font-weight: bold; -fx-font-size: 11px;"/>
                    <ComboBox fx:id="cmbFloor" maxWidth="Infinity" styleClass="combo-box"/>
                </VBox>

                <VBox spacing="4" prefWidth="145">
                    <Label text="Date" style="-fx-font-weight: bold; -fx-font-size: 11px;"/>
                    <DatePicker fx:id="dpDate" maxWidth="Infinity" styleClass="date-picker"/>
                </VBox>

                <VBox spacing="4" prefWidth="115">
                    <Label text="Start Time" style="-fx-font-weight: bold; -fx-font-size: 11px;"/>
                    <ComboBox fx:id="cmbStartTime" maxWidth="Infinity" styleClass="combo-box"/>
                </VBox>

                <VBox spacing="4" prefWidth="115">
                    <Label text="End Time" style="-fx-font-weight: bold; -fx-font-size: 11px;"/>
                    <ComboBox fx:id="cmbEndTime" maxWidth="Infinity" styleClass="combo-box"/>
                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <Button text="🔍 Refresh Grid" onAction="#handleRefreshGrid" styleClass="btn-primary" style="-fx-padding: 8 16;"/>
            </HBox>

            <!-- Preferences & Smart Recommendations -->
            <HBox spacing="16" alignment="CENTER_LEFT" style="-fx-padding: 8 0 0 0; -fx-border-color: -color-border; -fx-border-width: 1 0 0 0;">
                <Label text="Seat Preferences:" styleClass="text-muted" style="-fx-font-weight: bold;"/>
                <CheckBox fx:id="chkPower" text="🔌 Power Socket"/>
                <CheckBox fx:id="chkWindow" text="🪟 Near Window"/>
                <CheckBox fx:id="chkPc" text="🖥️ PC Terminal"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="✨ Smart Recommend" onAction="#handleSmartRecommend" styleClass="btn-secondary" style="-fx-font-size: 11px;"/>
            </HBox>
        </VBox>

        <!-- Floor 20-Seat Layout Container -->
        <VBox VBox.vgrow="ALWAYS" spacing="12" styleClass="card">
            <!-- Header & 4-Color Status Legend -->
            <HBox alignment="CENTER_LEFT" spacing="14">
                <VBox spacing="2">
                    <Label fx:id="lblFloorHeader" text="Floor Seating Layout" styleClass="text-heading"/>
                    <Label fx:id="lblFloorDescription" text="Select an available green seat pod (4x5 layout, 20 seats per floor)" styleClass="text-muted"/>
                    <Label fx:id="lblFloorLiveStats" text="20 Seats" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: -color-primary-text;"/>
                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <!-- Persistent 3-Color Legend (Available, Reserved, Occupied) -->
                <HBox spacing="14" alignment="CENTER" style="-fx-background-color: -color-bg-app; -fx-padding: 7 14; -fx-background-radius: 6; -fx-border-color: -color-border; -fx-border-width: 1;">
                    <HBox spacing="5" alignment="CENTER">
                        <Region prefWidth="12" prefHeight="12" style="-fx-background-color: -color-available-bg; -fx-border-color: -color-available-border; -fx-border-radius: 3; -fx-background-radius: 3;"/>
                        <Label text="Available" style="-fx-font-size: 11px;"/>
                    </HBox>
                    <HBox spacing="5" alignment="CENTER">
                        <Region prefWidth="12" prefHeight="12" style="-fx-background-color: -color-reserved-bg; -fx-border-color: -color-reserved-border; -fx-border-radius: 3; -fx-background-radius: 3;"/>
                        <Label text="Reserved" style="-fx-font-size: 11px;"/>
                    </HBox>
                    <HBox spacing="5" alignment="CENTER">
                        <Region prefWidth="12" prefHeight="12" style="-fx-background-color: -color-occupied-bg; -fx-border-color: -color-occupied-border; -fx-border-radius: 3; -fx-background-radius: 3;"/>
                        <Label text="Occupied" style="-fx-font-size: 11px;"/>
                    </HBox>
                </HBox>
            </HBox>

            <!-- Neat 4-Row x 5-Column Floor Seat Grid -->
            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent; -fx-background: transparent; -fx-padding: 6;">
                <GridPane fx:id="seatGridPane" hgap="16" vgap="16" alignment="TOP_CENTER" style="-fx-padding: 12;"/>
            </ScrollPane>
        </VBox>

    </VBox>

    <!-- Right Side: Booking Summary Drawer -->
    <VBox prefWidth="300" spacing="16" styleClass="card">
        <Label text="Booking Summary" styleClass="text-heading"/>

        <VBox fx:id="drawerEmptyState" spacing="10" alignment="CENTER" VBox.vgrow="ALWAYS">
            <Label text="🪑" style="-fx-font-size: 36px; -fx-opacity: 0.5;"/>
            <Label text="No Seat Selected" style="-fx-font-weight: bold; -fx-text-fill: -color-text-muted;"/>
            <Label text="Select a library floor and click any green Available seat tile (1–20) to view details and confirm."
                   wrapText="true" textAlignment="CENTER" styleClass="text-muted" style="-fx-font-size: 11px;"/>
        </VBox>

        <VBox fx:id="drawerContent" spacing="14" visible="false" managed="false">
            <VBox spacing="4" styleClass="drawer-seat-card">
                <Label text="SELECTED FLOOR &amp; SEAT" style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: -color-primary-text;"/>
                <Label fx:id="lblSummarySeatNumber" text="S-01" styleClass="drawer-seat-title"/>
                <Label fx:id="lblSummaryFloorName" text="Ground Floor — Section 1" styleClass="text-muted"/>
            </VBox>

            <VBox spacing="8" style="-fx-border-color: -color-border; -fx-border-width: 1 0 1 0; -fx-padding: 12 0;">
                <HBox>
                    <Label text="Floor:" styleClass="text-muted"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblSummaryFloorShort" text="Floor 0" style="-fx-font-weight: bold;"/>
                </HBox>
                <HBox>
                    <Label text="Date:" styleClass="text-muted"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblSummaryDate" text="2026-11-26" style="-fx-font-weight: bold;"/>
                </HBox>
                <HBox>
                    <Label text="Slot:" styleClass="text-muted"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblSummaryTime" text="10:00 AM - 12:00 PM" style="-fx-font-weight: bold;"/>
                </HBox>
                <HBox>
                    <Label text="Duration:" styleClass="text-muted"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblSummaryDuration" text="2 hr 0 min" style="-fx-font-weight: bold;"/>
                </HBox>
                <HBox>
                    <Label text="Facilities:" styleClass="text-muted"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblSummaryFacilities" text="Power, Window" style="-fx-font-size: 11px;"/>
                </HBox>
            </VBox>

            <VBox spacing="6">
                <Label text="Grace Period Rule:" style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: -color-reserved-border;"/>
                <Label text="Please check in within 15 minutes of your slot start. Unclaimed seats are automatically marked NO-SHOW."
                       wrapText="true" style="-fx-font-size: 10px; -fx-text-fill: -color-text-muted;"/>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

            <Button fx:id="btnConfirmBooking" text="Confirm Reservation" onAction="#handleConfirmBooking"
                    maxWidth="Infinity" styleClass="btn-primary" style="-fx-padding: 12;"/>
        </VBox>
    </VBox>

</HBox>
